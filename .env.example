# Copy to .env.local for local development, and add the same values in Vercel › Settings › Environment Variables.

# Sanity (sanity.io/manage). The site builds without it, but shows no articles until it is set.
NEXT_PUBLIC_SANITY_PROJECT_ID=eb5rh6pq
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity webhook that refreshes the site on publish (/api/revalidate).
SANITY_REVALIDATE_SECRET=

# Canonical URL used in sitemaps, RSS, canonical tags and structured data.
NEXT_PUBLIC_SITE_URL=https://www.dementiatoday.net
